# Copie para .env e preencha. NUNCA comite o .env.

# Chave do OpenCode (assinatura Go). Obrigatoria.
OPENCODE_API_KEY=oc_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Upstream do proxy.
UPSTREAM=https://opencode.ai/zen/go/v1

# Base URL usada pelo bolt (no compose: nome do servico).
OPENAI_LIKE_API_BASE_URL=http://proxy:8080/v1

# Modelo:limiteDeTokens separados por ';' (fallback de limites).
OPENAI_LIKE_API_MODELS=deepseek-v4.1-flash:200000;glm-5.3-flash:200000

TZ=America/Sao_Paulo
